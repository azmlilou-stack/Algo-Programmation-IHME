{
  "name": "algo-programmation-ihme",
  "version": "1.0.0",
  "private": true,
  "description": "Application de suivi des tests réalisés en laboratoire.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
