    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "users:create-operator": "node --env-file-if-exists=.env server/create-operator.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
